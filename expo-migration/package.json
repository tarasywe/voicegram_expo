{
  "name": "voicegram",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "doctor": "npx expo-doctor",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "node scripts/typecheck.mjs",
    "check": "biome ci . && node scripts/typecheck.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "build:local:android": "npx eas-cli@latest build --platform android --profile development --local",
    "build:local:ios": "npx eas-cli@latest build --platform ios --profile development --local",
    "build:dev": "npx eas-cli@latest build --profile development --platform all",
    "build:preview": "npx eas-cli@latest build --profile preview --platform all",
    "build:prod": "npx eas-cli@latest build --profile production --platform all",
    "update:preview": "npx eas-cli@latest update --branch preview",
    "update:prod": "npx eas-cli@latest update --branch production"
  },
  "dependencies": {
    "@expo/html-elements": "^0.12.5",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@legendapp/motion": "^2.5.3",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "expo": "57.0.4",
    "expo-asset": "57.0.3",
    "expo-audio": "57.0.0",
    "expo-constants": "57.0.3",
    "expo-crypto": "57.0.0",
    "expo-dev-client": "57.0.5",
    "expo-file-system": "57.0.0",
    "expo-font": "57.0.0",
    "expo-haptics": "57.0.0",
    "expo-image": "57.0.0",
    "expo-linking": "57.0.2",
    "expo-local-authentication": "57.0.0",
    "expo-localization": "57.0.0",
    "expo-router": "57.0.4",
    "expo-secure-store": "57.0.0",
    "expo-splash-screen": "57.0.2",
    "expo-status-bar": "57.0.0",
    "expo-symbols": "57.0.0",
    "expo-system-ui": "57.0.0",
    "expo-updates": "57.0.6",
    "react": "19.2.3",
    "react-aria": "^3.52.1",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draglist": "^3.11.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "0.36.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.13.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-stately": "^3.50.0",
    "tailwind-variants": "^0.1.20",
    "uniwind": "^1.12.0",
    "zod": "^4.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "^57.0.11",
    "jest": "~29.7.0",
    "jest-expo": "^57.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|uniwind|@gluestack-ui/.*|react-native-draglist)"
    ],
    "moduleNameMapper": {
      "^@ui/(.*)$": "<rootDir>/src/components/ui/$1",
      "^@features/(.*)$": "<rootDir>/src/features/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-svg"
      ]
    }
  },
  "overrides": {
    "expo-file-system": "57.0.0",
    "expo-audio": "57.0.0",
    "expo-haptics": "57.0.0",
    "expo-updates": "57.0.6",
    "expo-crypto": "57.0.0",
    "expo-local-authentication": "57.0.0",
    "expo-localization": "57.0.0",
    "expo-asset": "57.0.3",
    "expo-font": "57.0.0",
    "expo-image": "57.0.0",
    "expo-symbols": "57.0.0",
    "expo-system-ui": "57.0.0",
    "expo-status-bar": "57.0.0",
    "expo-secure-store": "57.0.0",
    "expo-constants": "57.0.3",
    "expo-linking": "57.0.2",
    "expo-splash-screen": "57.0.2",
    "expo-router": "57.0.4",
    "expo-dev-client": "57.0.5",
    "expo-dev-menu": "57.0.5",
    "expo-dev-launcher": "57.0.5",
    "expo-manifests": "57.0.0",
    "expo-json-utils": "57.0.0",
    "expo-structured-headers": "57.0.0",
    "expo-eas-client": "57.0.0",
    "expo-keep-awake": "57.0.0",
    "expo-modules-autolinking": "57.0.5",
    "expo-glass-effect": "57.0.0",
    "expo-modules-core": "57.0.3",
    "expo-modules-jsi": "57.0.1",
    "@expo/ui": "57.0.4",
    "@expo/cli": "57.0.6",
    "@expo/router-server": "57.0.2"
  }
}
